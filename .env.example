# ---------------------------------------------------------------------------
# DataJud — API Pública do CNJ
# ---------------------------------------------------------------------------
# A chave pública é publicada pelo próprio CNJ na documentação da API e é a
# mesma para todos os consumidores. Ver README ("Configurando o DataJud").
DATAJUD_API_KEY=

# ---------------------------------------------------------------------------
# X / Twitter — OAuth 1.0a user context (POST /2/tweets)
# ---------------------------------------------------------------------------
# Sem estas variáveis, scripts/post-twitter.ts recusa-se a postar e cai
# automaticamente em --dry-run.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
