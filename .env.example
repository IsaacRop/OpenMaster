# ---------------------------------------------------------------------------
# DataJud — API Pública do CNJ
# ---------------------------------------------------------------------------
# A chave pública é publicada pelo próprio CNJ na documentação da API e é a
# mesma para todos os consumidores. Ver README ("Configurando o DataJud").
DATAJUD_API_KEY=

# ---------------------------------------------------------------------------
# X / Twitter — OAuth 1.0a user context (POST /2/tweets)
# ---------------------------------------------------------------------------
# Sem estas variáveis, scripts/post-twitter.ts recusa-se a postar e cai
# automaticamente em --dry-run.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Agente IA — /api/agente
# ---------------------------------------------------------------------------
# Secret server-side; nunca exposta ao client (route.ts do App Router é
# server-only). Sem ela, POST /api/agente responde 502.
OPENAI_API_KEY=
# Nome do modelo, para trocar sem redeploy de código. Padrão: gpt-5-nano.
AGENTE_MODEL=gpt-5-nano
# Timeout da chamada à OpenAI, em ms. Padrão: 20000.
AGENTE_TIMEOUT_MS=20000
# Teto de tokens de saída por resposta. Padrão: 1600. Em modelos de
# raciocínio (gpt-5-nano e afins) esse teto cobre reasoning + resposta
# visível juntos — baixo demais e o modelo pode gastar tudo raciocinando e
# devolver conteúdo vazio.
AGENTE_MAX_OUTPUT_TOKENS=1600
# Esforço de raciocínio do modelo (minimal/low/medium/high). Padrão: low.
# Só se aplica a modelos de raciocínio; ignorado pelos demais.
AGENTE_REASONING_EFFORT=low

# --- rate limit de /api/agente ---------------------------------------------
# Store distribuído (recomendado em produção com mais de uma instância): as
# mesmas duas variáveis da integração Vercel KV / Upstash Redis. Sem elas, a
# rota cai automaticamente num fallback em memória do processo — correto para
# `npm run dev`, mas cada instância fria em produção conta separado.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Limite por IP e limite global (todos os IPs somados, por janela) — este
# último existe para travar abuso distribuído por muitos IPs diferentes, que
# o limite por IP sozinho não vê. Padrões: 10 e 300.
AGENTE_RATE_LIMIT_MAX=10
AGENTE_RATE_LIMIT_GLOBAL_MAX=300
# Duração da janela de contagem, em ms. Padrão: 600000 (10 min).
AGENTE_RATE_LIMIT_WINDOW_MS=600000
# `x-forwarded-for`/`x-real-ip` só são confiáveis quando um proxy de confiança
# os define. Na Vercel isso é automático (a plataforma seta VERCEL=1). Fora
# dela, só ligue TRUST_PROXY_HEADERS=true se houver um proxy reverso próprio
# (nginx, Cloudflare, etc.) configurado para sobrescrever esses cabeçalhos —
# do contrário, o rate limit por IP vira um único balde global (mais seguro
# como padrão do que confiar num cabeçalho que o cliente pode forjar).
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Privacidade de logs — hash de IP
# ---------------------------------------------------------------------------
# Segredo do HMAC usado para logar um hash do IP em vez do IP em texto puro
# (ver lib/agente/rate-limit.ts, hashParaLog). Sem este segredo o hash ainda é
# calculado (nunca logamos IP em claro), mas fica reversível por força bruta
# sobre o espaço de IPv4 — configure um valor aleatório longo em produção.
# Gerar um: `openssl rand -hex 32`
LOG_IP_HMAC_SECRET=
# "true" (padrão): mistura o dia UTC no HMAC, então o mesmo IP produz hashes
# diferentes em dias diferentes — agrupa abuso dentro do mesmo dia sem manter
# um identificador estável de longo prazo. "false": hash fixo, sem rotação.
LOG_IP_HASH_SALT_DIAS=true

# ---------------------------------------------------------------------------
# Conversas — /conversas (ingestão do MasterWhats)
# ---------------------------------------------------------------------------
# Commit fixo (40 hex) do repositório github.com/rafaelbressan/masterzap de
# onde os JSONs de conversa são buscados em runtime. Nunca aponte para "main"
# em produção: a branch muda sem aviso e sem nenhuma garantia de schema ter
# sido checada contra o novo conteúdo antes de ir ao ar. Padrão documentado
# (commit da branch main em 2026-09-17, dia deste endurecimento):
MASTERZAP_REF=f3303765a225de432b0004179fd256a933784ac5
